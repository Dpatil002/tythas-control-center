# ==============================================================================
# Tythas Control Center — Environment Configuration Template
# Copy this file to `.env` or `.env.local` and supply real production values.
# NEVER commit `.env` or `.env.local` with real secrets to version control.
# ==============================================================================

# Database (Neon / PostgreSQL)
# Pooled connection string used for runtime queries
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct unpooled connection string used for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Auth / NextAuth / Session Security
# Generate a secure 32+ char secret: openssl rand -hex 32
AUTH_SECRET="your-32-character-auth-secret-here-min32chars"
AUTH_URL="http://localhost:3000"
APP_ORIGIN="http://localhost:3000"

# MFA & Token Encryption (AES-256-GCM 32-byte key in Base64)
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="

# Email Service (Resend)
RESEND_API_KEY="re_sample_api_key"
EMAIL_FROM="Tythas Control Center <noreply@yourdomain.com>"

# Distributed Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://sample-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample_token"

# External Integrations — Google (GA4, GSC, GTM, Google Ads, GBP)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# External Integrations — Meta (Facebook Pixel, Conversions API, Ads)
META_APP_ID=""
META_APP_SECRET=""

# Google Performance & Core Web Vitals APIs (Optional / Recommended)
GOOGLE_PAGESPEED_API_KEY=""
GOOGLE_CRUX_API_KEY=""

# Seed Configuration (Development / Initial Setup only)
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="SecurePassword123!"

# Sentry Error Tracking (Optional)
SENTRY_DSN=""
